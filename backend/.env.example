OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# docker = isolated container build (recommended) | local = mvn on this host | skip = no build validation
VALIDATION_MODE=docker
# MAVEN_IMAGE is auto-detected from the project; set it only to force an image
VALIDATION_TIMEOUT=900
JARVIS_WORK_DIR=./workdir
CORS_ORIGINS=http://localhost:5173
